#READ.IN file for topological insulator model
#Please refer to Basic.f90 for how to complete this input file
SIZE    =4
RANGE   =2
CELLSIZE=2
# Site num, epsilon, intra_t_vals,  inter_t_vals (twice as many as range)
SITE    =1 0.0 -1.0 0.05 -1.0 0.05 
SITE    =2 0.0 -1.0 0.05 -1.0 0.05 
# In cell connections (always repeated in reverse)
CONNECT =1 2
# Out cell connections (fwrd connections)
CONNECTN=2 1
# Many body system terms
UPSPINS  =4
DOWNSPINS=4
HUBBARDU =8.0
#must ALWAYS end in 'EXIT' to avoid INFINITE LOOP
EXIT
